# ===============================================
# SOUL AI — Variables d'environnement (exemple)
# Copier en .env.local (local) ou configurer dans Vercel > Settings > Environment Variables
# Ne JAMAIS committer de valeurs secrètes.
# ===============================================

# --- Fournisseurs IA (exclusivement côté serveur) ---
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free

# Gemini / Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# xAI Grok — optionnel (https://console.x.ai) — provider prêt si clé fournie
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# --- Firebase (client — valeurs publiques de la config web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (serveur) : JSON du compte de service encodé en base64 ---
# base64 -w0 firebase-adminsdk-xxx.json
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Administration ---
# Emails admins séparés par des virgules (claim admin vérifié côté serveur)
ADMIN_EMAILS=
# Clé à usage unique permettant au premier login de recevoir le claim admin
ADMIN_SETUP_KEY=

# --- Application ---
NEXT_PUBLIC_APP_URL=
