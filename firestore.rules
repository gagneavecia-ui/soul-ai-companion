rules_version = '2';

// SOUL AI — Règles de sécurité Firestore strictes.
// Chaque utilisateur ne peut accéder qu'à ses propres données.
service cloud.firestore {
  match /databases/{database}/documents {

    // Données utilisateur (profil, préférences) — propriétaire uniquement
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Toutes les sous-collections: conversations, messages, mémoire persistante
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Configuration applicative (fournisseurs, prompt système) — lisible par les
    // utilisateurs connectés (aucun secret), modifiable par les admins uniquement.
    match /app/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Journal des erreurs — serveur (SDK admin, hors règles) + lecture admin
    match /admin_errors/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Statistiques globales — écriture serveur uniquement
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Refus par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function isAdmin() {
    return request.auth != null && request.auth.token.admin == true;
  }
}
